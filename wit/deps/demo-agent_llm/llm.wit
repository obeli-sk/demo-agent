package demo-agent:llm;

// Each call carries new messages and the accepted LLM execution IDs.
// The activity reconstructs history and uses the wire API in AGENT_MODELS.
interface chat {
  record completion-reply {
    // JSON array of assistant blocks (text + tool_use).
    content-json: string,
    stop-reason: string,
  }

  record rate-limit {
    retry-after-seconds: u32,
    message: string,
  }

  variant completion-result {
    reply(completion-reply),
    rate-limited(rate-limit),
  }

  completion: func(
    system: string,
    delta-json: string,
    tools-json: string,
    model: string,
    effort: string,
    history-ids: list<string>,
  ) -> result<completion-result, string>;
}

world exports {
  export chat;
}
